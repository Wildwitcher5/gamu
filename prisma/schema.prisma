generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Response {
  id         Int      @id @default(autoincrement())
  session_id String   @unique
  created_at DateTime @default(now())
  status     String   @default("incomplete")
  data       Json
}
